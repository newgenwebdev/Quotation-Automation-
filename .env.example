# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/newgen_office

# Four-eyes rule: the person who drafts a price cannot approve it.
# Set to "true" only if one finance person must both draft and approve.
ALLOW_SELF_APPROVAL=false

